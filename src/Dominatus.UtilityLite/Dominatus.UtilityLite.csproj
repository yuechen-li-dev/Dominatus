<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Dominatus.UtilityLite</PackageId>
    <Version>0.2.1</Version>
    <Authors>Dominatus Contributors</Authors>
    <Description>Compatibility package for Dominatus utility authoring. The canonical implementation now ships with Dominatus.OptFlow.</Description>
    <PackageTags>utility-ai;ai;hfsm;scoring;decision-making;game-ai</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/yuechen-li-dev/Dominatus</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yuechen-li-dev/Dominatus</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dominatus.OptFlow\Dominatus.OptFlow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UtilityLite.cs" />
    <Compile Remove="When.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
