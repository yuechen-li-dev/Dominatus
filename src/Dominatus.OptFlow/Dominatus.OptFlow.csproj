<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Dominatus.OptFlow</PackageId>
    <Version>1.0.0</Version>
    <Authors>Dominatus Contributors</Authors>
    <Description>OptFlow HFSM and utility authoring with durable operation sites, compile-time flow construction, and incremental-generator validation.</Description>
    <PackageTags>ai;agents;transitions;hfsm;utility-ai;control-kernel;control-flow;source-generator;incremental-generator;compile-time-validation;durable-operations</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/yuechen-li-dev/Dominatus</RepositoryUrl>
    <PackageProjectUrl>https://github.com/yuechen-li-dev/Dominatus</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dominatus.Core\Dominatus.Core.csproj" />
    <ProjectReference Include="..\Dominatus.OptFlow.Generators\Dominatus.OptFlow.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Dominatus.UtilityLite\UtilityLite.cs" Link="UtilityLite\UtilityLite.cs" />
    <Compile Include="..\Dominatus.UtilityLite\When.cs" Link="UtilityLite\When.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\Dominatus.OptFlow.Generators\bin\$(Configuration)\netstandard2.0\Dominatus.OptFlow.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
